# GEMINI_API_KEY: Legacy AI Studio integration (unused in QBX)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# QBX Agent / Grow Advisor — at least one provider key for npm run dev
# Recommended: DeepSeek V3 (deepseek-chat) for monitoring + grow help
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""

# APP_URL: Used by OpenRouter referer header
APP_URL="http://localhost:3000"

# Supabase (optional — enables auth + cloud persistence when configured)
# See scripts/SUPABASE_SETUP.md for full setup steps
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# true = login required (default when Supabase keys are set). false = offline dev (npm run dev:sim)
VITE_QBX_REQUIRE_AUTH="true"
# local = browser auth without Supabase (default when keys empty). supabase = cloud only
VITE_QBX_AUTH_BACKEND="local"
# Optional: seed platform admin on first login (Supabase bootstrap RPC) + local auth
VITE_QBX_SEED_ADMIN_EMAIL="alexmuego@gmail.com"
VITE_QBX_SEED_ADMIN_PASSWORD=""
VITE_QBX_SEED_ADMIN_NAME="Admin"
# supabase | local — with auth required, always uses supabase when keys are set
VITE_QBX_DATA_BACKEND="supabase"

# QBX Store (consumer devices — strips, hub, sense)
VITE_QBX_STORE_URL="https://shop.quantumbotanix.com"
VITE_QBX_DOCS_URL="https://docs.quantumbotanix.com"

# Commerce: off | enforce (default enforce on supabase prod; sim/local always off)
VITE_QBX_COMMERCE_MODE="off"
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=""
VITE_STRIPE_PRO_YEARLY_PRICE_ID=""
# See scripts/STRIPE_SETUP.md for production Stripe + Edge Functions

# Server-side only — migrations / CI scripts, never VITE_
SUPABASE_SERVICE_ROLE_KEY=""
